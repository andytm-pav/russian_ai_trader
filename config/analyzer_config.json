{
  "cache": {
    "ttl_seconds": 3600
  },

  "processing": {
    "max_text_length_chars": 512,
    "batch_size": 32,
    "deduplication_method": "title_hash"
  },

  "filter": {
    "use_ahocorasick": false,
    "use_word_forms": true,
    "min_word_length_for_forms": 3,
    "word_endings": ["", "а", "у", "ой", "ом", "е", "ы", "ов", "ам", "ами", "ах"],
    "word_exceptions": ["ия", "ие"],
    "include": [
      "акции", "акций", "акциям", "акциями",
      "ipo", "дивиденды", "дивидендов", "прибыль", "прибыли",
      "доход", "доходы", "капитализация", "котировки",
      "сбер", "сбербанк", "газпром", "лукойл", "роснефть", "компания",
      "втб", "яндекс", "магнит", "новатэк", "татнефть",
      "отчет", "отчеты", "прогноз", "прогнозы", "рейтинг", "рейтинги",
      "инвестиции", "брокер", "биржевой", "торги", "облигации",
      "фьючерсы", "опционы", "валюта", "валюты",
      "вырос", "выросли", "рост", "росла", "увеличился", "увеличились",
      "снизился", "снизились", "падение", "снижение", "упал", "упали",
      "экспорт", "импорт", "перевозки", "перевозок", "производство",
      "объем", "объемы", "рынок", "рынке", "рынка", "рынков",
      "экономика", "ввп", "инфляция", "ставка", "ставки",
      "курс", "курсы", "рубль", "рубля", "рублей", "доллар", "доллара",
      "нефть", "нефти", "нефтью", "нефтедобыча", "нефтепродукты",
      "спг", "газ", "бензин", "дизель", "цена", "цены", "цен",
      "спрос", "предложение", "индекс", "индексы", "мосбиржа",
      "минэнерго", "опек", "brent", "wti", "энергоносители",
      "виэ", "генерация", "электроэнергия", "мощности", "месторождения"
    ],
    "exclude": [
      "тюрьма", "продается", "декабристы", "здание",
  "спорт", "футбол", "хоккей", "ватерполист", "хет-трик", "цска",
  "паводок", "дождь", "погода", "дагестан", "ливни",
  "прокуратура", "уголовное", "криминал", "возбуждено",
  "парламент", "вето", "резолюция", "контакты",
  "актер", "певец", "шоу", "концерт", "фестиваль",
  "tehran", "переговоры", "политика"
    ]
  },

  "sentiment": {
    "use_ml": true,
    "use_lexicon_fallback": false,
    "ml_device": -1,
    "model_name": "mxlcw/rubert-tiny2-russian-financial-sentiment",
    "positive_threshold": 0.5,
    "negative_threshold": -0.5,
    "priority_weight": 0.1,
    "lexicon": {
      "positive": [
        "рост", "увеличение", "прибыль", "доход", "успех", "позитив", "хороший",
        "выше", "лучше", "рекорд", "максимум", "прорыв", "дивиденд", "buy", "покупка",
        "up", "growth", "profit", "positive", "gain", "rally", "повышение",
        "вырос", "выросли", "увеличился", "увеличились", "поднялся"
      ],
      "negative": [
        "падение", "снижение", "убыток", "потеря", "кризис", "негатив", "плохой",
        "ниже", "хуже", "минимум", "проблема", "долг", "sell", "продажа", "риск",
        "down", "loss", "negative", "drop", "crash", "decline", "обвал",
        "упал", "упали", "снизился", "снизились"
      ]
    }
  },

  "tickers": {
    "file_path": "config/tickers.json",
    "extract_from_title": true,
    "extract_from_content": false
  },

  "broker": {
    "enabled": true,
    "min_news_count": 1,
    "buy_threshold": 0.6,
    "sell_threshold": -0.6,
    "confidence_multiplier": 1.0,
    "max_signals_per_run": 10,
    "signal_cooldown_minutes": 0,
    "require_multiple_sources": false,
    "signal_blacklist": []
  }
}