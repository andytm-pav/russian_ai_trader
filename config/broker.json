{
  "broker_name": "tinkoff",
  "api_version": "v2",
  "paper_trading": true,
  "tinkoff": {
    "token": "YOUR_TINKOFF_TOKEN_HERE",
    "account_id": "YOUR_ACCOUNT_ID",
    "sandbox": true
  },
  "alor": {
    "refresh_token": "YOUR_ALOR_TOKEN",
    "account": "YOUR_ACCOUNT"
  },
  "order_settings": {
    "default_order_type": "limit",
    "time_in_force": "day",
    "use_wlim": true,
    "price_offset_percent": 0.1,
    "max_spread_percent": 0.5
  },
  "rate_limits": {
    "requests_per_minute": 60,
    "orders_per_minute": 10
  }
}